# Copy to scripts/oci-launch.env and fill in. Both OCIDs come from the console.
#
# COMPARTMENT_ID: Identity -> Compartments (use the root one; its name matches
#                 your account, e.g. desaiswayam19 (root))
# SUBNET_ID:      Networking -> Virtual Cloud Networks -> your VCN -> Subnets
#                 (the public subnet you already created)
COMPARTMENT_ID=ocid1.tenancy.oc1..
SUBNET_ID=ocid1.subnet.oc1..

# Defaults match the Always Free allowance exactly. Lower OCPUS/MEMORY only if
# you want better capacity odds — 1 OCPU / 6 GB lands far more often.
NAME=atlas
OCPUS=4
MEMORY=24
BOOT_GB=100
INTERVAL=60
SSH_KEY=~/.ssh/id_ed25519.pub
