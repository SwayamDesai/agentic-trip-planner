# copy to .env and fill in. never commit .env
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=

# optional real-data APIs (phase 3). agents run on LLM knowledge until set.
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=
OPENWEATHER_API_KEY=
GOOGLE_MAPS_API_KEY=

# optional LLM observability — leave blank to disable entirely
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
