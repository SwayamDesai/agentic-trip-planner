# copy to .env and fill in. never commit .env
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=

# optional real-data APIs (phase 3). agents run on LLM knowledge until set.
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=
OPENWEATHER_API_KEY=
GOOGLE_MAPS_API_KEY=

# optional LLM observability — leave blank to disable entirely
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# API gateway (optional; GATEWAY=1 to enable)
GATEWAY=
GATEWAY_KEY_SALT=
GATEWAY_LIMITER=limits

# --- data layer (deploy/oracle/compose.data.yml) ---
# Generate once:  openssl rand -hex 24
POSTGRES_PASSWORD=
POSTGRES_USER=atlas
POSTGRES_DB=atlas
REDIS_MAXMEMORY=512mb

# Reachable only from inside the compose network, so the hostnames are the
# service names rather than localhost.
DATABASE_URL=postgresql://atlas:CHANGEME@postgres:5432/atlas
LITELLM_DATABASE_URL=postgresql://atlas:CHANGEME@postgres:5432/litellm
REDIS_URL=redis://redis:6379/0

# --- LLM gateway (deploy/oracle/compose.llm.yml) ---
# openssl rand -hex 24  for each
LITELLM_MASTER_KEY=sk-
LITELLM_SALT_KEY=
# Set to route through the proxy; unset to call providers directly.
LITELLM_BASE_URL=http://litellm:4000

# --- prompt registry (optional; falls back to the prompts in the image) ---
# Which published label the app follows, and how long a fetch is trusted.
PROMPT_LABEL=production
PROMPT_CACHE_TTL=300
# Development only: serve prompts from a directory of <name>.md files instead.
# PROMPT_DIR=./prompts

# --- self-hosted Langfuse (deploy/oracle/compose.langfuse.yml) ---
#
# Every one of these is mandatory: the compose file uses `${VAR:?}` so a missing
# value fails the stack at start-up rather than booting something half
# configured. Generate each with `openssl rand -hex 32`.
#
# Skip this whole block if you point LANGFUSE_HOST at Langfuse Cloud instead —
# which is the right choice on a 1 GB instance, where ClickHouse alone will
# evict the app.
CLICKHOUSE_PASSWORD=
MINIO_ROOT_PASSWORD=
LANGFUSE_SALT=
LANGFUSE_NEXTAUTH_SECRET=
# Must be exactly 64 hex characters: openssl rand -hex 32
LANGFUSE_ENCRYPTION_KEY=
# The login for the Langfuse UI on first boot.
LANGFUSE_INIT_USER_EMAIL=admin@atlas.local
LANGFUSE_INIT_USER_PASSWORD=
# Self-hosted: point the app at the container, and let first boot provision
# these exact keys so nothing has to be copied out of the UI by hand.
#   LANGFUSE_HOST=http://langfuse-web:3000
#   LANGFUSE_PUBLIC_KEY=pk-lf-<any stable value>
#   LANGFUSE_SECRET_KEY=sk-lf-<any stable value>

# --- the public hostname (deploy/oracle) ---
# Set this and Caddy obtains a Let's Encrypt certificate for it automatically.
# Leave it unset and the stack serves plain HTTP on :80, which is fine locally
# and wrong for anything you would put in a CV.
# DOMAIN=plan.example.com

# --- gateway ---
# Hashing salt for issued API keys. CHANGING IT INVALIDATES EVERY KEY EVER
# ISSUED, so set it once, before issuing any, and never rotate it casually.
GATEWAY_KEY_SALT=
# Whose X-Forwarded-For to believe. Empty means trust nobody, which is the safe
# default: believing the header from an untrusted peer lets any caller mint a
# fresh identity per request and walk past the rate limit. The production
# compose sets this to the private ranges, which is safe only because the app
# port is not published.
# GATEWAY_TRUSTED_PROXIES=172.16.0.0/12,10.0.0.0/8,192.168.0.0/16
