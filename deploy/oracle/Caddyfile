# Caddy config. Two modes, chosen by whether DOMAIN is set.
#
# With a domain, Caddy obtains and renews a Let's Encrypt certificate on its
# own — no certbot, no cron, no renewal to forget. Without one it serves plain
# HTTP, because Let's Encrypt will not issue a certificate for a bare IP.

{$DOMAIN} {
	# Long-lived responses: one plan takes 60-150s on free-tier models, and an
	# SSE stream stays open throughout. The defaults would cut both off.
	reverse_proxy app:8000 {
		transport http {
			read_timeout 600s
			write_timeout 600s
		}
		# SSE must not be buffered, or the browser sees nothing until the
		# stream closes — which defeats the point of streaming progress.
		flush_interval -1
	}

	encode gzip

	header {
		# Modest hardening. Not a substitute for anything, but free.
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}

	log {
		output stdout
		format console
	}
}
